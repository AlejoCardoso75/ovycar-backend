{
  "info": {
    "_postman_id": "ovycar-admin-usuarios-001",
    "name": "OvyCar — Admin crear usuario",
    "description": "0) Primer admin con X-Ovycar-Bootstrap-Secret si la BD está vacía. 1) Login. 2) Crear más usuarios con JWT ADMIN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ovycar-backend-production.up.railway.app/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bootstrapSecret",
      "value": "CAMBIA_IGUAL_QUE_EN_RAILWAY_OVYCAR_BOOTSTRAP_SECRET"
    }
  ],
  "item": [
    {
      "name": "0. Auth — Primer admin (BD vacía, sin JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Ovycar-Bootstrap-Secret",
            "value": "{{bootstrapSecret}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"Alejo75\",\n  \"password\": \"Manchas123.\",\n  \"nombre\": \"Alejandro\",\n  \"apellido\": \"Cardoso\",\n  \"email\": \"alejandro.cardosoparra@gmail.com\",\n  \"rol\": \"ADMIN\",\n  \"activo\": true\n}"
        },
        "url": "{{baseUrl}}/auth/bootstrap-first-admin",
        "description": "Solo si `usuarios` está vacío. En Railway: Variables → OVYCAR_BOOTSTRAP_SECRET = mismo valor que `bootstrapSecret` aquí. Tras crear el admin, borre la variable en Railway."
      }
    },
    {
      "name": "1. Auth — Login (copiar token a variable {{token}})",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"AdminOvy\",\n  \"password\": \"Manchas123.\"\n}"
        },
        "url": "{{baseUrl}}/auth/login",
        "description": "Ajusta username/password a un admin que ya exista en Railway. En la respuesta JSON, copia el valor de `token` a la variable de colección `token`."
      }
    },
    {
      "name": "2. Admin — Crear usuario Alejo75",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"Alejo75\",\n  \"password\": \"Manchas123.\",\n  \"nombre\": \"Alejandro\",\n  \"apellido\": \"Cardoso\",\n  \"email\": \"alejandro.cardosoparra@gmail.com\",\n  \"rol\": \"ADMIN\",\n  \"activo\": true\n}"
        },
        "url": "{{baseUrl}}/admin/usuarios",
        "description": "Crea el usuario con contraseña hasheada en servidor. Requiere `token` de un ADMIN."
      }
    }
  ]
}
